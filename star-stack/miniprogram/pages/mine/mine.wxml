<view class="hero">
  <view class="me">
    <view class="avatar">星</view>
    <view>
      <view class="nm">星标开发者</view>
      <view class="bio">Vibe coder · 用 AI 快速造物</view>
    </view>
  </view>
</view>

<view class="stats">
  <view class="st"><view class="n">12</view><view class="l">发布</view></view>
  <view class="st"><view class="n">328</view><view class="l">获赞</view></view>
  <view class="st"><view class="n">46</view><view class="l">收藏</view></view>
  <view class="st"><view class="n">89</view><view class="l">关注</view></view>
</view>

<view class="pub" bindtap="goPublish">
  <image class="pi" src="{{icons.plus}}" /><text>发布分享（工具网站 / 热门项目 / 经验技巧）</text>
</view>

<view class="group">
  <view class="row" bindtap="goPosts">
    <image class="ri" src="{{icons.post}}" /><text>我的分享</text><text class="cnt">12 篇 ›</text>
  </view>
  <view class="row" data-t="收藏列表开发中" bindtap="toast">
    <image class="ri" src="{{icons.star}}" /><text>我的收藏</text><text class="cnt">46 ›</text>
  </view>
  <view class="row" data-t="浏览历史开发中" bindtap="toast">
    <image class="ri" src="{{icons.history}}" /><text>浏览历史</text><text class="cnt">›</text>
  </view>
</view>

<view class="group">
  <view class="row" data-t="设置开发中" bindtap="toast">
    <image class="ri" src="{{icons.cog}}" /><text>设置</text><text class="cnt">›</text>
  </view>
  <view class="row" data-t="感谢反馈，功能开发中" bindtap="toast">
    <image class="ri" src="{{icons.feedback}}" /><text>意见反馈</text><text class="cnt">›</text>
  </view>
  <view class="row" data-t="星栈 StarStack v0.1" bindtap="toast">
    <image class="ri" src="{{icons.about}}" /><text>关于</text><text class="cnt">›</text>
  </view>
</view>
