page { padding-bottom: 140rpx; }

.hero {
  background: #07C160;
  padding: 48rpx 32rpx 92rpx;
}

.me { display: flex; align-items: center; gap: 24rpx; }

.avatar {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  background: linear-gradient(135deg, #5b6ef5, #8f6ef5);
  border: 4rpx solid rgba(255, 255, 255, .6);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 44rpx; font-weight: 600;
}

.nm { font-size: 36rpx; font-weight: 700; color: #fff; }
.bio { font-size: 24rpx; color: rgba(255, 255, 255, .85); margin-top: 6rpx; }

.stats {
  background: #fff;
  border-radius: 24rpx;
  margin: -60rpx 24rpx 20rpx;
  display: flex;
  padding: 28rpx 0;
  position: relative;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, .04);
}

.st { flex: 1; text-align: center; }
.st .n { font-size: 34rpx; font-weight: 700; }
.st .l { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.pub {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #07C160;
  font-weight: 600;
  font-size: 28rpx;
}

.pi { width: 34rpx; height: 34rpx; }

.group {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 24rpx 20rpx;
  overflow: hidden;
}

.row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  border-bottom: 1rpx solid #EDEDED;
}

.row:last-child { border-bottom: none; }
.row .cnt { margin-left: auto; font-size: 24rpx; color: #999; }
.ri { width: 36rpx; height: 36rpx; }
