page {
  background: #F2F2F2;
  color: #1a1a1a;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.tag {
  font-size: 22rpx;
  color: #666;
  background: #F2F2F2;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  margin-right: 12rpx;
}

.tag.g {
  color: #07C160;
  background: #e8f9ef;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}

.chan-badge {
  font-size: 20rpx;
  color: #07C160;
  background: #e8f9ef;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  flex-shrink: 0;
}

.chan-badge.hot {
  color: #e6573c;
  background: #fdeee9;
}

.chan-badge.vibe {
  color: #5b6ef5;
  background: #eceffb;
}

.cicon {
  width: 30rpx;
  height: 30rpx;
  margin-right: 8rpx;
}
